# Copy to deploy/.env on the server (chmod 600). Never commit the real file.

POSTGRES_USER=dice_app
POSTGRES_PASSWORD=change_me_long_random
POSTGRES_DB=dice_app

# Addresses Caddy serves (a bare domain gets HTTPS automatically); www redirects to WEB_URL.
WEB_ADDRESS=example.com
WWW_ADDRESS=www.example.com
API_ADDRESS=api.example.com

# Full URLs: the browser calls API_URL; the API accepts requests only from WEB_URL (CORS).
WEB_URL=https://example.com
API_URL=https://api.example.com

# Image tag to run, e.g. a commit SHA; defaults to latest.
# IMAGE_TAG=latest

# Local test over plain HTTP only:
# WEB_ADDRESS=http://app.localhost
# WWW_ADDRESS=http://www.app.localhost
# API_ADDRESS=http://api.localhost
# WEB_URL=http://app.localhost
# API_URL=http://api.localhost
# COOKIE_SECURE=false
