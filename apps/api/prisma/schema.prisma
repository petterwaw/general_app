generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Gra {
  id                String       @id @default(cuid())
  status            StatusGry    @default(LOBBY)
  revision          Int          @default(0)
  ostatniaAktywnosc DateTime     @default(now())
  dataUtworzenia    DateTime     @default(now())
  aktualnyGraczId   String?      @unique
  aktualnyGracz     Uczestnik?   @relation("AktualnyGraczGry", fields: [aktualnyGraczId], references: [id])
  aktualneKosci     Json?
  zdarzenia         LogZdarzen[]
  uczestnicy        Uczestnik[]  @relation("UczestnicyGry")
}

model Uczestnik {
  id           String @id @default(cuid())
  imie         String
  kartaWynikow Json
  kolejnosc    Int
  gameId       String
  aktualnaGraW Gra?   @relation("AktualnyGraczGry")
  gra          Gra    @relation("UczestnicyGry", fields: [gameId], references: [id])
}

model LogZdarzen {
  id                String   @id @default(cuid())
  typAkcji          String
  dane              Json
  revisionPo        Int
  kluczIdempotencji String
  dataUtworzenia    DateTime @default(now())
  gameId            String
  gra               Gra      @relation(fields: [gameId], references: [id])

  @@unique([gameId, kluczIdempotencji])
}

enum StatusGry {
  LOBBY
  TRWA
  ZAKONCZONA
  PORZUCONA
  WYGASLA
}
