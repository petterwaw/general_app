generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id              String       @id @default(cuid())
  creationKey     String?      @unique
  status          GameStatus   @default(LOBBY)
  revision        Int          @default(0)
  lastActivity    DateTime     @default(now())
  createdAt       DateTime     @default(now())
  currentPlayerId String?      @unique
  currentPlayer   Participant? @relation("CurrentPlayerGame", fields: [currentPlayerId], references: [id])
  diceSource      DiceSource   @default(PHYSICAL)
  currentDice     Json?
  // Virtual dice only: rolls made in the current turn and the positions held in the last one.
  rollNumber      Int?
  heldInLastRoll  Int[]        @default([])
  hostIdentityId  String?
  hostIdentity    Identity?    @relation("HostedGames", fields: [hostIdentityId], references: [id])
  events          EventLog[]
  participants    Participant[]
}

model Participant {
  id          String          @id @default(cuid())
  name        String
  scoreCard   Json
  // Written once, when the game is COMPLETED; null until then. A record of the game as played,
  // not recomputed if the scoring rules ever change.
  finalScore  Int?
  upperBonus  Int?
  turnOrder   Int
  role        ParticipantRole @default(PLAYER)
  userId      String?
  identityId  String?
  identity    Identity?       @relation(fields: [identityId], references: [id])
  // True while the participant is still in a LOBBY / IN_PROGRESS game: false once the game ends or
  // they leave it. A partial unique index on identityId (hand-written SQL in the migration) allows
  // one active game per device, local or online.
  active      Boolean         @default(true)
  currentGame Game?           @relation("CurrentPlayerGame")
  gameId      String
  game        Game             @relation(fields: [gameId], references: [id])

  @@index([userId])
  @@index([identityId])
  @@index([gameId, turnOrder])
}

model Identity {
  id           String        @id @default(cuid())
  secretHash   String
  createdAt    DateTime      @default(now())
  participants Participant[]
  hostedGames  Game[]        @relation("HostedGames")
}

model EventLog {
  id             String   @id @default(cuid())
  actionType     String
  payload        Json
  revisionAfter  Int
  idempotencyKey String
  createdAt      DateTime @default(now())
  gameId         String
  game           Game     @relation(fields: [gameId], references: [id])

  @@unique([gameId, idempotencyKey])
}

enum GameStatus {
  LOBBY
  IN_PROGRESS
  COMPLETED
  ABANDONED
  EXPIRED
}

enum DiceSource {
  PHYSICAL
  VIRTUAL
}

enum ParticipantRole {
  HOST
  PLAYER
  OBSERVER
}