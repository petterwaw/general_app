// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusGry {
  LOBBY
  TRWA
  ZAKONCZONA
  PORZUCONA
  WYGASLA
}

model Gra {
  id                String    @id @default(cuid())
  status            StatusGry @default(LOBBY)
  revision          Int       @default(0)
  ostatniaAktywnosc DateTime  @default(now())
  dataUtworzenia    DateTime  @default(now())

  uczestnicy Uczestnik[]  @relation("UczestnicyGry")
  zdarzenia  LogZdarzen[]

  aktualnyGraczId String?    @unique
  aktualnyGracz   Uczestnik? @relation("AktualnyGraczGry", fields: [aktualnyGraczId], references: [id])
}

model Uczestnik {
  id           String @id @default(cuid())
  imie         String
  kartaWynikow Json
  kolejnosc    Int

  gameId String
  gra    Gra    @relation("UczestnicyGry", fields: [gameId], references: [id])

  aktualnaGraW Gra? @relation("AktualnyGraczGry")
}

model LogZdarzen {
  id                String   @id @default(cuid())
  typAkcji          String
  dane              Json
  revisionPo        Int
  kluczIdempotencji String
  dataUtworzenia    DateTime @default(now())

  gameId String
  gra    Gra    @relation(fields: [gameId], references: [id])

  @@unique([gameId, kluczIdempotencji])
}
